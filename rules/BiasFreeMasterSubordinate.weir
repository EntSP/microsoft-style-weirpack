expr main (master/slave)

let message "Consider 'master/subordinate' instead of 'master/slave'."
let description "Microsoft Writing Style Guide: BiasFree."
let kind "Usage"
let becomes "master/subordinate"

test "We should master/slave today." "We should master/subordinate today."
